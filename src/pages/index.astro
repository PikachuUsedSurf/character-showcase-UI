---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import GameCard from "../components/GameCard.astro";

const games = (await getCollection("games", (g) => g.data.enabled !== false)).sort((a, b) => a.data.order - b.data.order);
const characters = await getCollection("characters");

const glyphs: Record<string, string> = {
  "honkai-star-rail": "HSR",
  "reverse-1999": "R99",
  "duet-night-abyss": "DNA",
};

const cards = games.map((game) => {
  const gameCharacters = characters.filter((c) => c.id.startsWith(`${game.id}/`));
  const withSprite = gameCharacters.find((c) => c.data.sprite);
  return {
    game,
    characterCount: gameCharacters.length,
    heroImage: withSprite ? `/images/${game.id}/${withSprite.data.sprite}` : undefined,
    glyph: glyphs[game.id] ?? game.data.name.slice(0, 3).toUpperCase(),
  };
});
---

<BaseLayout title="Select Deployment" description="One archive, one interface — pick a game to browse its roster.">
  <Nav />
  <div class="wrap">
    <div class="hero">
      <p class="eyebrow">Select Deployment</p>
      <h1>Choose your operation</h1>
      <p>One archive, one interface, {games.length} titles tracked. Every game below runs the same dossier, roster, and tier-list system — only the accent color and the data change.</p>
      <div class="search-wrap" data-hub-search>
        <div class="query">
          <input type="text" id="search-input" placeholder="search across all titles..." autocomplete="off" />
          <span id="search-hint">⏎ SEARCH</span>
        </div>
        <div class="search-results" id="search-results" hidden></div>
      </div>
    </div>

    <div class="grid-head">
      <h2>Available Titles</h2>
      <span>{games.length} registered</span>
    </div>

    <div class="games">
      {cards.map(({ game, characterCount, heroImage, glyph }) => (
        <GameCard
          slug={game.id}
          name={game.data.name}
          accent={game.data.accent}
          status={game.data.status}
          description={game.data.description}
          characterCount={characterCount}
          heroImage={heroImage}
          glyph={glyph}
        />
      ))}
    </div>

    <div class="foot">
      <p>ARCHIVE NETWORK — hub v0.1</p>
      <p>one component system · per-title accent tokens</p>
    </div>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .hero {
    padding: 72px 0 44px;
    text-align: center;
  }

  .hero .eyebrow {
    font: 600 11px/1 var(--f-mono);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 18px;
  }

  .hero h1 {
    font: 700 clamp(32px, 5.4vw, 54px)/1.05 var(--f-display);
    color: var(--ink-hi);
    text-transform: uppercase;
  }

  .hero p {
    font: 400 14.5px/1.7 var(--f-body);
    color: var(--muted);
    max-width: 52ch;
    margin: 18px auto 0;
  }

  .search-wrap {
    position: relative;
    max-width: 480px;
    margin: 32px auto 0;
    text-align: left;
  }

  .query {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--line-strong);
    background: var(--panel);
    padding: 11px 16px;
  }

  .search-results {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: var(--panel);
    border: 1px solid var(--line-strong);
    max-height: 340px;
    overflow-y: auto;
    z-index: 30;
  }

  /*
    The result items below are injected client-side via innerHTML, so Astro's
    scoped-style hash never lands on them — these rules must be :global().
  */
  :global(.search-item) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    font: 400 12.5px var(--f-mono);
  }

  :global(.search-item:last-child) {
    border-bottom: 0;
  }

  :global(.search-item:hover),
  :global(.search-item.active) {
    background: var(--panel-2);
  }

  :global(.search-item .s-name) {
    color: var(--ink-hi);
    font-weight: 600;
  }

  :global(.search-item .s-role) {
    color: var(--dim);
    font-size: 11px;
    margin-left: 6px;
  }

  :global(.search-item .s-game) {
    font: 600 9.5px var(--f-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 7px;
    border: 1px solid var(--line-strong);
    white-space: nowrap;
    flex: none;
  }

  :global(.search-empty) {
    padding: 14px 16px;
    color: var(--muted);
    font: 400 12px var(--f-mono);
  }

  .query::before {
    content: ">";
    color: var(--accent);
    font: 700 14px var(--f-mono);
  }

  .query input {
    flex: 1;
    background: none;
    border: 0;
    color: var(--ink);
    font: 400 13px var(--f-mono);
    outline: 0;
  }

  .query input::placeholder {
    color: var(--dim);
  }

  .query span {
    font: 500 9.5px var(--f-mono);
    color: var(--dim);
    letter-spacing: 0.05em;
  }

  .grid-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 56px 0 22px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .grid-head h2 {
    font: 700 15px var(--f-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-hi);
  }

  .grid-head span {
    font: 500 10.5px var(--f-mono);
    color: var(--dim);
    letter-spacing: 0.05em;
  }

  .games {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    padding-bottom: 80px;
  }

  @media (max-width: 760px) {
    .games {
      grid-template-columns: 1fr;
    }
  }

  .foot {
    padding: 0 0 60px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }

  .foot p {
    font: 400 11.5px var(--f-mono);
    color: var(--dim);
    margin: 0;
  }
</style>

<script>
  type Entry = { name: string; role: string; game: string; gameName: string; accent: string; href: string };

  const wrap = document.querySelector<HTMLElement>("[data-hub-search]");
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const results = document.getElementById("search-results");
  if (wrap && input && results) {
    let index: Entry[] = [];
    let active = -1;
    let indexPromise: Promise<void> | null = null;

    function ensureIndex(): Promise<void> {
      if (!indexPromise) {
        indexPromise = fetch("/search-index.json")
          .then((res) => res.json())
          .then((data) => {
            index = data;
          })
          .catch(() => {
            index = [];
          });
      }
      return indexPromise;
    }

    function render(query: string) {
      const q = query.trim().toLowerCase();
      active = -1;
      if (!q) {
        results!.hidden = true;
        results!.innerHTML = "";
        return;
      }
      const matches = index.filter((e) => e.name.toLowerCase().includes(q)).slice(0, 8);
      results!.innerHTML = "";
      if (matches.length === 0) {
        const empty = document.createElement("div");
        empty.className = "search-empty";
        empty.textContent = `No characters matching "${query}".`;
        results!.appendChild(empty);
      } else {
        matches.forEach((m) => {
          const a = document.createElement("a");
          a.className = "search-item";
          a.href = m.href;
          a.innerHTML = `<span><span class="s-name">${escapeHtml(m.name)}</span><span class="s-role">${escapeHtml(m.role)}</span></span><span class="s-game" style="color:${m.accent};border-color:${m.accent}">${escapeHtml(m.gameName)}</span>`;
          results!.appendChild(a);
        });
      }
      results!.hidden = false;
    }

    function escapeHtml(s: string) {
      return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
    }

    function items() {
      return Array.from(results!.querySelectorAll<HTMLAnchorElement>(".search-item"));
    }

    function setActive(i: number) {
      const list = items();
      list.forEach((el) => el.classList.remove("active"));
      if (i >= 0 && i < list.length) {
        list[i].classList.add("active");
        list[i].scrollIntoView({ block: "nearest" });
      }
      active = i;
    }

    input.addEventListener("focus", ensureIndex);
    input.addEventListener("input", async () => {
      await ensureIndex();
      render(input.value);
    });

    input.addEventListener("keydown", (e) => {
      const list = items();
      if (e.key === "ArrowDown") {
        e.preventDefault();
        if (list.length) setActive((active + 1) % list.length);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        if (list.length) setActive((active - 1 + list.length) % list.length);
      } else if (e.key === "Enter") {
        if (active >= 0 && list[active]) {
          window.location.href = list[active].href;
        } else if (list.length === 1) {
          window.location.href = list[0].href;
        }
      } else if (e.key === "Escape") {
        results.hidden = true;
        input.blur();
      }
    });

    document.addEventListener("click", (e) => {
      if (!wrap.contains(e.target as Node)) {
        results.hidden = true;
      }
    });
  }
</script>
