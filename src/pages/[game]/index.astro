---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import FilterBar from "../../components/FilterBar.astro";
import CharacterCard from "../../components/CharacterCard.astro";

export async function getStaticPaths() {
  const games = await getCollection("games");
  return games.map((game) => ({
    params: { game: game.id },
    props: { game },
  }));
}

const { game } = Astro.props;
const allCharacters = await getCollection("characters");
const roster = allCharacters
  .filter((c) => c.id.startsWith(`${game.id}/`))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const roles = Array.from(new Set(roster.map((c) => c.data.role ?? c.data.tag).filter((r): r is string => !!r))).sort();
---

<BaseLayout title={`${game.data.name} Roster`} description={game.data.description} accent={game.data.accent}>
  <Nav game={{ slug: game.id, name: game.data.name }} active="roster" />
  <div class="wrap">
    <div class="pageh">
      <div>
        <p class="eyebrow">Deployment — {game.data.name}</p>
        <h1>Roster</h1>
      </div>
      <div class="count">
        {roster.length} character{roster.length === 1 ? "" : "s"} archived
      </div>
    </div>

    {roster.length > 0 ? (
      <>
        <div class="controls">
          <FilterBar roles={roles} />
        </div>
        <div class="roster">
          {roster.map((c) => (
            <CharacterCard
              href={`/${game.id}/characters/${c.id.split("/")[1]}`}
              name={c.data.name}
              role={c.data.role}
              tag={c.data.tag}
              unitNo={c.data.unitNo}
              rarity={c.data.rarity}
              sprite={c.data.sprite ? `/images/${game.id}/${c.data.sprite}` : undefined}
              kitPending={c.data.kitPending}
            />
          ))}
        </div>
      </>
    ) : (
      <div class="empty">
        <p>No units archived for {game.data.name} yet — this deployment is {game.data.status === "planned" ? "scheduled" : "in progress"}.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .pageh {
    padding: 44px 0 32px;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .pageh .eyebrow {
    font: 600 10.5px/1 var(--f-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 12px;
  }

  .pageh h1 {
    font: 700 clamp(28px, 4vw, 40px)/1.05 var(--f-display);
    color: var(--ink-hi);
    text-transform: uppercase;
  }

  .count {
    font: 400 10.5px var(--f-mono);
    color: var(--dim);
    text-align: right;
    white-space: nowrap;
  }

  .controls {
    margin: 26px 0 24px;
  }

  .roster {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    padding-bottom: 70px;
  }

  @media (max-width: 980px) {
    .roster {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .roster {
      grid-template-columns: 1fr;
    }
  }

  .empty {
    padding: 60px 0;
    font: 400 13px/1.6 var(--f-body);
    color: var(--muted);
  }
</style>
